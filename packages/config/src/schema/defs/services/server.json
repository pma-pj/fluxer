{
	"server_service": {
		"type": "object",
		"description": "Configuration for the main Fluxer Server.",
		"additionalProperties": false,
		"properties": {
			"host": {
				"type": "string",
				"description": "Network interface to bind to.",
				"default": "0.0.0.0"
			},
			"port": {
				"type": "number",
				"description": "Port to listen on.",
				"default": 8772
			},
			"static_dir": {
				"type": "string",
				"description": "Path to static assets directory for the web app. Required in production."
			},
			"csp": {
				"description": "CSP (Content Security Policy) configuration to prevent cross-site scripting (XSS) and other attacks.",
				"$ref": "#/$defs/csp",
				"default": {
					"directives": {
						"defaultSrc": ["'self'"],
						"scriptSrc": ["'self'", "'unsafe-inline'"],
						"styleSrc": ["'self'", "'unsafe-inline'", "https://fluxerstatic.com"],
						"imgSrc": ["'self'", "data:", "blob:", "https://fluxerstatic.com"],
						"connectSrc": ["'self'", "wss:", "ws:"],
						"fontSrc": ["'self'", "https://fluxerstatic.com"],
						"mediaSrc": ["'self'", "blob:"],
						"frameSrc": ["'none'"]
					}
				}
			}
		}
	}
}
